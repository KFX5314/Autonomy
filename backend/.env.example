# Copy this file to backend/.env for local backend configuration.
# Values here override script-provided local defaults, but real process
# environment variables with non-default values still take precedence.

# Runtime safety
PRODUCTION=0
JWT_SECRET=dev-only-insecure-secret
CORS_ORIGINS=http://localhost:19000,http://localhost:19006,http://localhost:8081

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tfg_demencia
DB_USER=tfg_app
DB_PASSWORD=tfg_pass_2024

# Request limits / concurrency
MAX_BODY_BYTES=52428800
MAX_CONCURRENT_AUDIO=5

# STT
STT_MODEL=medium
STT_DEVICE=cuda
STT_NO_SPEECH_THRESHOLD=0.7
STT_LOG_PROB_THRESHOLD=-0.8
STT_COMPRESSION_RATIO_THRESHOLD=2.2
STT_MIN_SILENCE_MS=300
STT_INITIAL_PROMPT=Conversación en español entre una persona mayor y su cuidador.

# Speaker identification
SPEAKER_DEVICE=cpu
SPEAKER_DIARIZATION_THRESHOLD=0.40
TTS_ECHO_MATCH_WINDOW_MS=30000
TTS_ECHO_MATCH_RATIO=0.82
TTS_ECHO_MIN_CHARS=12

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=mistral:7b-instruct
LLM_ALERT_MIN_SEVERITY=3
OLLAMA_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Memory / retention
STM_WINDOW_MINUTES=5
STM_MAX_UTTERANCES=12
STM_MAX_CHARS=1500
JOURNAL_INTERVAL_MINUTES=5
JOURNAL_RETENTION_HOURS=24
JOURNAL_MAX_ENTRIES=200
TRANSCRIPT_RETENTION_DAYS=14
TRANSCRIPT_MAX_ROWS=5000

# Alert audio retention
# ALERTS_AUDIO_DIR defaults to backend/data/alert_audio when unset.
# ALERTS_AUDIO_DIR=C:\path\to\alert_audio
ALERT_AUDIO_MAX_FILES_PER_PATIENT=50
ALERT_AUDIO_MAX_DAYS=30
